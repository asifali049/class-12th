[
  {
    "id": "f1",
    "title": {
      "en": "Quantization of Charge",
      "hi": "आवेश का क्वांटीकरण",
      "hinglish": "Charge ka Quantization"
    },
    "formula": "q = \\pm ne",
    "variables": [
      {
        "symbol": "q",
        "name": { "en": "Total charge", "hi": "कुल आवेश" }
      },
      {
        "symbol": "n",
        "name": { "en": "Integer (1, 2, 3...)", "hi": "पूर्णांक (1, 2, 3...)" }
      },
      {
        "symbol": "e",
        "name": { "en": "Elementary charge ($1.6 \\times 10^{-19} C$)", "hi": "मूल आवेश ($1.6 \\times 10^{-19} C$)" }
      }
    ],
    "unit": { "en": "Coulomb (C)", "hi": "कूलॉम (C)" },
    "importance": "High",
    "examTip": {
      "en": "Used to find number of electrons in a given amount of charge.",
      "hi": "किसी दिए गए आवेश में इलेक्ट्रॉनों की संख्या ज्ञात करने के लिए उपयोग किया जाता है।"
    }
  },
  {
    "id": "f2",
    "title": {
      "en": "Coulomb's Law in Vector Form",
      "hi": "सदिश रूप में कूलॉम का नियम",
      "hinglish": "Coulomb's Law Vector Form mein"
    },
    "formula": "\\vec{F}_{12} = \\frac{1}{4\\pi\\epsilon_0} \\frac{q_1 q_2}{r_{21}^2} \\hat{r}_{21}",
    "variables": [
      {
        "symbol": "\\vec{F}_{12}",
        "name": { "en": "Force on $q_1$ due to $q_2$", "hi": "$q_2$ के कारण $q_1$ पर बल" }
      },
      {
        "symbol": "\\hat{r}_{21}",
        "name": { "en": "Unit vector pointing from $q_2$ to $q_1$", "hi": "$q_2$ से $q_1$ की ओर संकेत करने वाला एकांक सदिश" }
      }
    ],
    "unit": { "en": "Newton (N)", "hi": "न्यूटन (N)" }
  },
  {
    "id": "f3",
    "title": {
      "en": "Electric Field Intensity due to a Point Charge",
      "hi": "बिंदु आवेश के कारण विद्युत क्षेत्र की तीव्रता",
      "hinglish": "Point Charge ke karan Electric Field"
    },
    "formula": "E = \\frac{1}{4\\pi\\epsilon_0} \\frac{q}{r^2}",
    "variables": [
      {
        "symbol": "E",
        "name": { "en": "Electric field", "hi": "विद्युत क्षेत्र" }
      },
      {
        "symbol": "r",
        "name": { "en": "Distance from the charge", "hi": "आवेश से दूरी" }
      }
    ],
    "unit": { "en": "N/C or V/m", "hi": "N/C या V/m" }
  },
  {
    "id": "f4",
    "title": {
      "en": "Electric Dipole Moment",
      "hi": "विद्युत द्विध्रुव आघूर्ण",
      "hinglish": "Electric Dipole Moment"
    },
    "formula": "\\vec{p} = q(2\\vec{a})",
    "variables": [
      {
        "symbol": "\\vec{p}",
        "name": { "en": "Dipole moment (points from -q to +q)", "hi": "द्विध्रुव आघूर्ण (-q से +q की ओर)" }
      },
      {
        "symbol": "2\\vec{a}",
        "name": { "en": "Displacement vector from -q to +q", "hi": "-q से +q तक विस्थापन सदिश" }
      }
    ],
    "unit": { "en": "Coulomb-meter (C·m)", "hi": "कूलॉम-मीटर (C·m)" }
  },
  {
    "id": "f5",
    "title": {
      "en": "Torque on a Dipole in Uniform Electric Field",
      "hi": "एकसमान विद्युत क्षेत्र में द्विध्रुव पर बल आघूर्ण",
      "hinglish": "Uniform Electric Field mein Dipole par Torque"
    },
    "formula": "\\vec{\\tau} = \\vec{p} \\times \\vec{E} \\implies \\tau = pE \\sin\\theta",
    "variables": [
      {
        "symbol": "\\tau",
        "name": { "en": "Torque", "hi": "बल आघूर्ण" }
      },
      {
        "symbol": "\\theta",
        "name": { "en": "Angle between dipole moment and electric field", "hi": "द्विध्रुव आघूर्ण और विद्युत क्षेत्र के बीच का कोण" }
      }
    ],
    "unit": { "en": "Newton-meter (N·m)", "hi": "न्यूटन-मीटर (N·m)" },
    "importance": "High"
  },
  {
    "id": "f6",
    "title": {
      "en": "Gauss's Law",
      "hi": "गॉस का नियम",
      "hinglish": "Gauss's Law"
    },
    "formula": "\\Phi_E = \\oint \\vec{E} \\cdot d\\vec{A} = \\frac{q_{\\text{enclosed}}}{\\epsilon_0}",
    "variables": [
      {
        "symbol": "\\Phi_E",
        "name": { "en": "Electric flux", "hi": "विद्युत फ्लक्स" }
      },
      {
        "symbol": "q_{\\text{enclosed}}",
        "name": { "en": "Net charge enclosed by the surface", "hi": "सतह द्वारा घिरा कुल आवेश" }
      }
    ],
    "unit": { "en": "N·m²/C or V·m", "hi": "N·m²/C या V·m" },
    "importance": "High"
  }
]