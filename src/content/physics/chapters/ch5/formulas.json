    "unit": { "en": "Am² or J/T", "hi": "Am² या J/T" }
  },
  {
    "id": "f2",
    "title": {
      "en": "Magnetic Field of a Bar Magnet (Axial Line)",
      "hi": "छड़ चुंबक का अक्षीय रेखा पर चुंबकीय क्षेत्र",
      "hinglish": "Axial Line par B"
    },
    "formula": "B = \\frac{\\mu_0}{4\\pi} \\frac{2mr}{(r^2 - l^2)^2} \\approx \\frac{\\mu_0}{4\\pi} \\frac{2m}{r^3} \\quad \\text{(for } r \\gg l \\text{)}",
    "variables": [
      { "symbol": "m", "name": { "en": "Magnetic dipole moment", "hi": "चुंबकीय द्विध्रुव आघूर्ण" } },
      { "symbol": "r", "name": { "en": "Distance from centre", "hi": "केंद्र से दूरी" } }
    ],
    "importance": "High"
  },
  {
    "id": "f3",
    "title": {
      "en": "Magnetic Field of a Bar Magnet (Equatorial Line)",
      "hi": "छड़ चुंबक का निरक्षीय रेखा पर चुंबकीय क्षेत्र",
      "hinglish": "Equatorial Line par B"
    },
    "formula": "B = \\frac{\\mu_0}{4\\pi} \\frac{m}{(r^2 + l^2)^{3/2}} \\approx \\frac{\\mu_0}{4\\pi} \\frac{m}{r^3} \\quad \\text{(for } r \\gg l \\text{)}",
    "variables": [
      { "symbol": "m", "name": { "en": "Magnetic dipole moment", "hi": "चुंबकीय द्विध्रुव आघूर्ण" } }
    ]
  },
  {
    "id": "f4",
    "title": {
      "en": "Torque on a Magnetic Dipole in a Uniform Field",
      "hi": "एकसमान चुंबकीय क्षेत्र में द्विध्रुव पर बल आघूर्ण",
      "hinglish": "Torque on Dipole"
    },
    "formula": "\\vec{\\tau} = \\vec{m} \\times \\vec{B} \\implies \\tau = mB \\sin \\theta",
    "variables": [
      { "symbol": "\\theta", "name": { "en": "Angle between m and B", "hi": "m और B के बीच का कोण" } }
    ]
  },
  {
    "id": "f5",
    "title": {
      "en": "Potential Energy of a Magnetic Dipole",
      "hi": "चुंबकीय द्विध्रुव की स्थितिज ऊर्जा",
      "hinglish": "Potential Energy of Dipole"
    },
    "formula": "U = -\\vec{m} \\cdot \\vec{B} = -mB \\cos \\theta",
    "variables": [
      { "symbol": "U", "name": { "en": "Potential Energy", "hi": "स्थितिज ऊर्जा" } }
    ]
  },
  {
    "id": "f6",
    "title": {
      "en": "Relations in Magnetism",
      "hi": "चुंबकत्व में संबंध",
