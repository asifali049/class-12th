      "hinglish": "Magnetic Dipole Moment"
    },
    "formula": "m = q_m \\times 2l \\quad \\text{(Bar Magnet)}\nm = N I A \\quad \\text{(Current Loop)}",
    "variables": [
      { "symbol": "q_m", "name": { "en": "Pole strength", "hi": "ध्रुव प्रबलता" } },
      { "symbol": "2l", "name": { "en": "Magnetic length", "hi": "चुंबकीय लंबाई" } },
      { "symbol": "N", "name": { "en": "Number of turns", "hi": "फेरों की संख्या" } },
      { "symbol": "I", "name": { "en": "Current", "hi": "विद्युत धारा" } },
      { "symbol": "A", "name": { "en": "Area of loop", "hi": "लूप का क्षेत्रफल" } }
